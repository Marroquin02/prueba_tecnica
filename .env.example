# ============================================
# Configuración de Docker Compose
# ============================================

# Target de build: development o production
BUILD_TARGET=development

# ============================================
# Configuración de la API Laravel
# ============================================
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ============================================
# Configuración de Base de Datos PostgreSQL
# ============================================
POSTGRES_DB=reportes_db
POSTGRES_USER=reportes_user
POSTGRES_PASSWORD=reportes_password

# ============================================
# Configuración de Redis
# ============================================
REDIS_PASSWORD=null

# ============================================
# Configuración de Caché y Sesiones
# ============================================
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ============================================
# Configuración de Correo SMTP
# ============================================
# Opciones de MAIL_MAILER: smtp, sendmail, mailgun, ses, postmark, resend, log, array
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicación
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME="Sistema de Reportes"

# ============================================
# Configuración del Frontend Nuxt.js
# ============================================
NODE_ENV=development
NUXT_PUBLIC_API_URL=http://api:80
